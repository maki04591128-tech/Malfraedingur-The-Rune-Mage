msgstr "Málfræðingur"

msgid "ui.menu.start"
msgstr "Start"

msgid "ui.menu.continue"
msgstr "Continue"

msgid "ui.menu.settings"
msgstr "Settings"

msgid "ui.menu.exit"
msgstr "Exit"

# === spell_lab ===
msgid "spell_lab.title"
msgstr "Spell Lab"

msgid "spell_lab.cast_button"
msgstr "Cast"

msgid "spell_lab.batch_button"
msgstr "Simulate %d times"

msgid "spell_lab.comprehension_slider"
msgstr "Comprehension C"

# === GrammarReport general messages ===
msgid "grammar.case_agreement.fail"
msgstr "Case mismatch"

msgid "grammar.word_order.fail"
msgstr "Word order is not canonical"

msgid "grammar.recommended_format"
msgstr "%s → %s ?"

# === GrammarReport reason / recommended templates (03 appendix B) ===

# case_agreement violation
msgid "grammar.case_agreement.reason"
msgstr "%s is not %s"

msgid "grammar.case_agreement.recommended"
msgstr "%s → %s ?"

msgid "grammar.case_agreement.missing_target"
msgstr "Missing object (requires %s)"

# word_order — VO violation
msgid "grammar.word_order.vo_violation"
msgstr "Verb must precede object (V→O imperative)"

msgid "grammar.word_order.vo_recommended"
msgstr "Move the verb first: %s ..."

# word_order — modifier adjacency
msgid "grammar.word_order.modifier_adjacency"
msgstr "Adjective must be adjacent to its noun (prepositive preferred)"

msgid "grammar.word_order.modifier_adjacency_recommended"
msgstr "Move modifier right before the object"

# word_order — element inserted
msgid "grammar.word_order.element_inserted"
msgstr "Element must come before the verb or after the object (don't split the noun phrase)"

msgid "grammar.word_order.element_inserted_recommended"
msgstr "Move element to clause-initial or clause-final"

# elements — half-baked combo
msgid "grammar.elements.partial_combo"
msgstr "Incomplete elemental combo fails (%s)"

msgid "grammar.elements.partial_combo_recommended"
msgstr "Use all four (%s) for chaos, or just one for attribute"

# modifier — standalone
msgid "grammar.modifier.standalone"
msgstr "Modifier (%s) must be cast with an effect word"

msgid "grammar.modifier.standalone_recommended"
msgstr "Add an effect word (e.g. meiða)"

# modifier_agreement — case mismatch
msgid "grammar.modifier_agreement.case_mismatch"
msgstr "%s (%s) must agree with object %s (%s) in gender, number, and case"

msgid "grammar.modifier_agreement.recommended"
msgstr "%s → %s ?"

msgid "grammar.modifier_agreement.no_form"
msgstr "Inflection form not found for %s (gender=%s, case=%s)"

# === Case names ===
msgid "grammar.case.nom"
msgstr "nominative"

msgid "grammar.case.acc"
msgstr "accusative"

msgid "grammar.case.dat"
msgstr "dative"

msgid "grammar.case.gen"
msgstr "genitive"

# === INC-3.5 v0.9.5: range / direction core violations (09 §7.3) ===

# range_required: cast out of range (raised by SpatialResolver)
msgid "grammar.range_required.reason"
msgstr "%s is out of range (target %d tiles away)"

msgid "grammar.range_required.recommended"
msgstr "Move closer or change range word"

# range_conflict: multiple range words
msgid "grammar.range_conflict.reason"
msgstr "Multiple range words: %s (only one allowed per spell)"

msgid "grammar.range_conflict.recommended"
msgstr "Keep only one range word (no simultaneous near/far)"

# direction_required: shape range word without direction
msgid "grammar.direction_required.reason"
msgstr "%s (area/piercing) requires a direction"

msgid "grammar.direction_required.recommended"
msgstr "Add a direction word (fram/aptr/vinstri/hœgri)"

# === INC-5.1 language-supervision scaffolds (freetext + number + mood) ===

# unknown_word: freetext form not found in dictionary
msgid "grammar.unknown_word.reason"
msgstr "\"%s\" is not in the dictionary (misfire ×4)"

msgid "grammar.unknown_word.recommended"
msgstr "Check spelling, or watch inflection (fjanda is accusative, fjandi is nominative)"

# number_agreement: modifier vs target number mismatch
msgid "grammar.number_agreement.reason"
msgstr "%s (%s) must agree in number with target %s (%s)"

msgid "grammar.number_agreement.recommended"
msgstr "Match singular/plural"

# mood_required: effect verb not in imperative
msgid "grammar.mood_required.reason"
msgstr "%s is not imperative (currently: %s; chant as a command)"

msgid "grammar.mood_required.recommended"
msgstr "Use imperative 2sg (e.g., meið) or 2pl (e.g., meiðið)"

# === Number labels ===
msgid "grammar.number.sg"
msgstr "singular"

msgid "grammar.number.pl"
msgstr "plural"

# === Verb mood labels ===
msgid "grammar.mood.inf"
msgstr "infinitive"

msgid "grammar.mood.imp_2sg"
msgstr "imperative 2sg"

msgid "grammar.mood.imp_2pl"
msgstr "imperative 2pl"

msgid "grammar.mood.ind_3sg"
msgstr "indicative 3sg"
